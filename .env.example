# Copy this file to .env and fill in the values
# The participant and judge models are configured independently and may use different providers, endpoints, and tokens

# --- Participant model ---
# Provider adapter name
PARTICIPANT_LLM_PROVIDER=
# Model name as expected by the API (required)
PARTICIPANT_LLM_MODEL=
# API key / token (required, never logged or saved to results)
PARTICIPANT_LLM_TOKEN=
# API base URL
PARTICIPANT_LLM_BASE_URL=

# --- Judge model (scores textual opinions in [0.0, 1.0]) ---
JUDGE_LLM_PROVIDER=
JUDGE_LLM_MODEL=
JUDGE_LLM_TOKEN=
JUDGE_LLM_BASE_URL=
