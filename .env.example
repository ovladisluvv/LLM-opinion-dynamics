# Copy this file to .env and fill in the values
#
# Credentials are keyed by PROVIDER, not by role: the experiment YAML says which
# provider and model each role (participant, judge) uses, and this file supplies
# the token and endpoint for every provider mentioned there.
#
#   <PROVIDER>_LLM_TOKEN      API key (never logged or saved to results)
#   <PROVIDER>_LLM_BASE_URL   endpoint root; optional when the provider has a default
#
# Registered providers (agents/llm_client.py, PROVIDERS):
#   openai             default URL https://api.openai.com/v1, token required
#   openai_compatible  any chat-completions endpoint; URL required, token optional
#   ollama             default URL http://localhost:11434/v1, no token
#   vllm               default URL http://localhost:8000/v1, no token

# --- experiment to run when --config is not passed on the command line ---
EXPERIMENT_CONFIG=config/example_experiment_config_degroot.yaml

# --- openai or an openai-compatible proxy ---
OPENAI_LLM_TOKEN=
# OPENAI_LLM_BASE_URL=https://api.openai.com/v1

# --- local ollama server (only if it is not on the default port) ---
# OLLAMA_LLM_BASE_URL=http://localhost:11434/v1

# --- local vllm server ---
# VLLM_LLM_BASE_URL=http://localhost:8000/v1
# token only if the server was started with --api-key
# VLLM_LLM_TOKEN=

# --- any other openai-compatible endpoint ---
# OPENAI_COMPATIBLE_LLM_TOKEN=
# OPENAI_COMPATIBLE_LLM_BASE_URL=
